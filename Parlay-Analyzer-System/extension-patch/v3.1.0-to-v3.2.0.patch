+    var out = [];
+    for (var i = 0; i < teams.length; i++) {
+      var team = teams[i] || {};
+      var text = statBlockText(team.stat_data);
+      if (!text) continue;
+      if (rule.forbidden.test(text) && !rule.required.test(text)) {
+        out.push(String(team.raw_team_name || 'UNKNOWN'));
